{
  "name": "sauce-demo-cypress",
  "type": "module",
  "version": "1.0.0",
  "description": "Cypress E2E + API test suite for Sauce Demo with Allure reporting and CI/CD via GitHub Actions",
  "author": "Maxitestr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maxitestr/sauce-demo-cypress.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@shelex/cypress-allure-plugin": "2.41.2",
    "@types/node": "26.5.0",
    "allure-commandline": "2.40.0",
    "cypress": "15.14.2",
    "eslint": "8.57.0",
    "eslint-plugin-cypress": "2.15.2",
    "prettier": "3.3.2",
    "typescript": "~6.0.0"
  },
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run --headless --browser chrome --env allure=true",
    "cy:run:e2e": "cypress run --spec cypress/e2e/**/*.cy.js --headless --browser chrome --env allure=true",
    "cy:run:api": "cypress run --spec cypress/api/**/*.cy.js --headless --browser chrome --env allure=true",
    "allure:generate": "npx -p allure-commandline@2.40.0 allure generate allure-results --clean -o allure-report",
    "allure:open": "npx -p allure-commandline@2.40.0 allure open allure-report",
    "test:allure": "npm run cy:run && npm run allure:generate",
    "lint": "eslint cypress --ext .js",
    "lint:fix": "eslint cypress --ext .js --fix",
    "format": "prettier --write ."
  }
}
